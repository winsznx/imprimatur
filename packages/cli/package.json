{
  "name": "@imprimatur/cli",
  "version": "0.1.0",
  "description": "Sign frontend releases onto Arkiv, revoke them, and verify any deployed origin.",
  "license": "MIT",
  "type": "module",
  "bin": { "imprimatur": "./dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --target node22 --noExternal @imprimatur/core",
    "dev": "tsx --env-file-if-exists=../../.env src/index.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "@imprimatur/core": "workspace:*",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
